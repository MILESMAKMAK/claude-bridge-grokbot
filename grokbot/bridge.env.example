# 复制为 bridge.env（不要提交！），chmod 600
# 源码目录 / 数据目录 / 端口
BRIDGE_REPO=/home/box/claude-bridge-grokbot
BRIDGE_DATA=/home/box/bridge-srv
BRIDGE_PORT=8787
# Worker 中继（把 <worker-name>.<your-subdomain> 换成你自己的）
RELAY_URL=wss://<worker-name>.<your-subdomain>.workers.dev/__relay/agent
# 与 `wrangler secret put RELAY_SECRET` 相同的随机串；或放在 RELAY_SECRET_FILE 指向的文件里
RELAY_SECRET=
# RELAY_SECRET_FILE=/home/box/bridge-ops/relay.secret
# Claude Code 长期令牌（需 Pro/Max，`claude setup-token` 生成）
CLAUDE_CODE_OAUTH_TOKEN=
